<div class="card" style="margin-top: 20px;">
  <div class="card-header">Filtros</div>
  <div class="card-body">
    <%= form_with url: request.path, method: :get, local: true do |form| %>
      <div class="filters">
        <div><%= form.label :aluno, "Aluno" %><%= form.text_field :aluno, value: params[:aluno] %></div>
        <div><%= form.label :curso, "Disciplina" %><%= form.text_field :curso, value: params[:curso] %></div>
        <div><%= form.label :matricula, "Matricula" %><%= form.text_field :matricula, value: params[:matricula] %></div>
        <div><%= form.label :lastaccess, "Acesso" %><%= form.select :lastaccess, [["Todos", ""], ["Sem acesso", "sem_acesso"], ["Com acesso", "com_acesso"]], selected: params[:lastaccess] %></div>
        <div><%= form.label :dias_sem_acesso, "Dias sem acesso" %><%= form.text_field :dias_sem_acesso, value: params[:dias_sem_acesso], placeholder: "ex: 15 ou 15-30" %></div>
        <div><%= form.label :curso_perfil, "Curso perfil" %><%= form.text_field :curso_perfil, value: params[:curso_perfil] %></div>
        <div><%= form.label :periodo_perfil, "Periodo perfil" %><%= form.text_field :periodo_perfil, value: params[:periodo_perfil] %></div>
        <div><%= form.label :unidade_fisica, "Polo" %><%= form.text_field :unidade_fisica, value: params[:unidade_fisica] %></div>
        <div><%= form.label :enrolment_status, "Status" %><%= form.text_field :enrolment_status, value: params[:enrolment_status] %></div>
        <div><%= form.label :periodo, "Periodo" %><%= form.text_field :periodo, value: params[:periodo].presence || "2026-1" %></div>
      </div>
      <div class="actions" style="margin-top: 14px;">
        <%= form.submit "Filtrar", class: "btn" %>
        <%= link_to "Limpar", request.path, class: "btn secondary" %>
      </div>
    <% end %>
  </div>
</div>
