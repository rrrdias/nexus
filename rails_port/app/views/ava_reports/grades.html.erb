<h1 class="page-title"><%= @title %></h1>
<p class="muted">Acompanhamento de notas, medias e acesso.</p>

<div class="actions" style="margin-top: 16px;">
  <%= link_to "Exportar CSV", grades_report_export_path(@institution, request.query_parameters), class: "btn secondary" %>
  <%= button_to "Sincronizar", reports_sync_path, method: :post, params: { institution: @institution, type: "grades" }, class: "btn" %>
</div>

<%= render "filters" %>

<%= render "metric_cards", cards: [
  ["Media global", @metrics[:average_media], "#{@metrics[:total_records]} matriculas", "var(--green)"],
  ["Abaixo da media", @metrics[:below_expected], "#{@metrics[:average_below_expected]}%", "var(--red)"],
  ["Media F1", @metrics[:average_fase1], "fase 1", "var(--blue)"],
  ["Alunos sem acesso", @metrics[:count_alunos_sem_acesso], "#{@metrics[:percent_alunos_sem_acesso].round(1)}%", "var(--amber)"]
] %>

<div class="card" style="margin-top: 20px;">
  <div class="card-header">Registros</div>
  <div class="card-body">
    <table class="table">
      <thead>
        <tr>
          <th>Aluno</th><th>Matricula</th><th>Disciplina</th><th>Periodo</th><th>Ultimo acesso</th><th>Notas</th><th>Media</th><th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @metrics[:data].each do |row| %>
          <tr>
            <td><strong><%= row["student_name"] %></strong><br><span class="muted"><%= row["user_username"] %></span></td>
            <td><%= row["user_identification"] %></td>
            <td><%= row["course_fullname"] %><br><span class="muted"><%= row["curso_perfil"] %></span></td>
            <td><%= row["periodo_perfil"].presence || row["periodo"] %></td>
            <td><%= row["lastaccess"].presence || "-" %><br><span class="badge"><%= row["diasSemAcesso"] %> dias</span></td>
            <td>F1 <%= row["fase1"] %> | F2 <%= row["fase2"] %> | F3 <%= row["fase3"] %></td>
            <td><strong><%= row["media"] %></strong></td>
            <td><span class="badge"><%= row["enrolment_status"].presence || "-" %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "pagination", metrics: @metrics %>
  </div>
</div>
