<h1 class="page-title">Grupos</h1>
<p class="muted">Gerencie grupos e acessos a modulos.</p>

<div class="card" style="margin-top: 20px;">
  <div class="card-header">Novo grupo</div>
  <div class="card-body">
    <%= form_with model: Group.new, url: admin_groups_path, local: true, class: "grid grid-2" do |form| %>
      <div><%= form.label :name, "Nome" %><%= form.text_field :name, required: true %></div>
      <div><%= form.label :description, "Descricao" %><%= form.text_field :description %></div>
      <div>
        <label>Modulos</label>
        <%= select_tag "module_ids[]", options_from_collection_for_select(@modules, :id, :name), multiple: true %>
      </div>
      <div><%= form.submit "Criar grupo", class: "btn" %></div>
    <% end %>
  </div>
</div>

<div class="card" style="margin-top: 20px;">
  <div class="card-header">Grupos cadastrados</div>
  <div class="card-body">
    <table class="table">
      <thead><tr><th>Nome</th><th>Descricao</th><th>Modulos</th><th>Acoes</th></tr></thead>
      <tbody>
        <% @groups.each do |group| %>
          <tr>
            <td><strong><%= group.name %></strong></td>
            <td><%= group.description %></td>
            <td><%= group.system_modules.map(&:name).join(", ").presence || "-" %></td>
            <td class="actions">
              <%= button_to "Excluir", admin_group_path(group), method: :delete, class: "btn danger small", form: { data: { turbo_confirm: "Excluir grupo?" } } %>
            </td>
          </tr>
          <tr>
            <td colspan="4">
              <details>
                <summary>Editar <%= group.name %></summary>
                <%= form_with model: group, url: admin_group_path(group), method: :patch, local: true, class: "grid grid-2", style: "margin-top: 12px;" do |form| %>
                  <div><%= form.label :name, "Nome" %><%= form.text_field :name, required: true %></div>
                  <div><%= form.label :description, "Descricao" %><%= form.text_field :description %></div>
                  <div>
                    <label>Modulos</label>
                    <%= select_tag "module_ids[]", options_from_collection_for_select(@modules, :id, :name, group.system_module_ids), multiple: true %>
                  </div>
                  <div><%= form.submit "Salvar", class: "btn" %></div>
                <% end %>
              </details>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
