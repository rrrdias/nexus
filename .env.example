# ==========================================
# NEXUS CORE - ENVIRONMENT CONFIGURATION
# ==========================================

# Portas de Rede
PORT=3004
BACKEND_PORT=3004
FRONTEND_PORT=3002

# PostgreSQL Database (Senha padrão local: 1213122)
DB_PASSWORD=1213122
DATABASE_URL=postgresql://admin:1213122@localhost:5433/core_db

# Redis Job Queue (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend Secrets
JWT_SECRET=super_secret_key_nexus_2026_dev_environment
CRON_SECRET=gerar-uma-chave-aleatoria-para-o-cron-job
SEED_ADMIN_PASSWORD=admin

# Frontend Next.js Options
NEXT_PUBLIC_API_URL=http://localhost:3004
NEXT_API_URL=http://localhost:3004
FRONTEND_URL=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
AUTH_SECRET=minha-super-secret-1234567890
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3002/api/auth

# Academic/report period configuration
NEXUS_DEFAULT_PERIOD=2026-2
NEXT_PUBLIC_NEXUS_DEFAULT_PERIOD=2026-2
NEXUS_FASE1_START=2026-02-13
NEXUS_FASE1_END=2026-03-29
NEXUS_FASE2_START=2026-03-30
NEXUS_FASE2_END=2026-05-11
NEXUS_FASE3_START=2026-05-12
NEXUS_FASE3_END=2026-06-19
NEXT_PUBLIC_NEXUS_FASE1_START=2026-02-13
NEXT_PUBLIC_NEXUS_FASE1_END=2026-03-29
